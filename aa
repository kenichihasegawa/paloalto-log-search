#!/usr/bin/env bash
#
# logcheck.sh - fluentd ログ受信状況の確認
#
# 使い方:
#   ./logcheck.sh <センサ一覧ファイル> <時刻指定>
#
#   センサ一覧ファイル : 1行に「顧客識別子 センサ識別子」(スペース区切り)
#                        例) ABCDE paum1234
#                        顧客識別子 : 大文字アルファベット4〜5文字
#                        センサ識別子: 小文字で始まる英数字4文字+数字4桁
#                                      (paum1234 / tmds1234 など)
#                        空行と # で始まる行は無視します。
#   時刻指定           : "HH:MM" (当日扱い) または "YYYY-MM-DD HH:MM"
#
# 例:
#   ./logcheck.sh sensors.txt 09:30
#   ./logcheck.sh sensors.txt "2026-11-20 09:30"
#
# 判定:
#   1. /var/customerlog の threat / traffic の .log の最終更新時刻を確認
#   2. threat が時刻指定以降に更新されていれば threat は正常
#   3. threat が未更新のセンサだけ /opt/fluent/buffer の .buff.meta の中身から
#      センサ識別子を探す (1秒間隔、初回を含めて合計3回)。見つかれば正常
#   4. traffic が未更新の場合は結果に記載するだけ (buffer 確認の条件にはしない)
#
# 終了コード: 0=異常なし / 1=異常あり / 2=引数や入力の誤り
#
# 次の環境変数で既定値を変更できます:
#   CUSTOMERLOG_DIR (既定 /var/customerlog)
#   BUFFER_DIR      (既定 /opt/fluent/buffer)
#   OUTPUT_DIR      (既定 カレントディレクトリ)

set -u
shopt -s nullglob

CUSTOMERLOG_DIR="${CUSTOMERLOG_DIR:-/var/customerlog}"
BUFFER_DIR="${BUFFER_DIR:-/opt/fluent/buffer}"
OUTPUT_DIR="${OUTPUT_DIR:-.}"
BUFFER_ATTEMPTS=3      # buffer 確認の試行回数 (初回を含む)
BUFFER_INTERVAL=1      # 試行の間隔 (秒)

usage() {
    echo "使い方: $0 <センサ一覧ファイル> <時刻指定>" >&2
    echo "  時刻指定: \"HH:MM\" (当日) または \"YYYY-MM-DD HH:MM\"" >&2
    exit 2
}

# ---------- 引数 ----------
[ $# -ge 2 ] || usage
LIST_FILE="$1"
shift
TIME_SPEC="$*"         # 引用符なしで 日付 時刻 と渡された場合も受け付ける

if [ ! -r "$LIST_FILE" ]; then
    echo "エラー: センサ一覧ファイルを読めません: $LIST_FILE" >&2
    exit 2
fi

if [[ "$TIME_SPEC" =~ ^[0-9]{1,2}:[0-9]{2}$ ]]; then
    TIME_SPEC="$(date +%F) $TIME_SPEC"
elif [[ ! "$TIME_SPEC" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}\ [0-9]{1,2}:[0-9]{2}$ ]]; then
    echo "エラー: 時刻指定の形式が不正です: $TIME_SPEC" >&2
    usage
fi

if ! THRESHOLD=$(date -d "$TIME_SPEC" +%s 2>/dev/null); then
    echo "エラー: 時刻指定を解釈できません: $TIME_SPEC" >&2
    exit 2
fi

for d in "$CUSTOMERLOG_DIR" "$BUFFER_DIR"; do
    if [ ! -d "$d" ]; then
        echo "エラー: ディレクトリがありません: $d" >&2
        exit 2
    fi
done

fmt_time() { date -d "@$1" '+%F %T'; }

# 指定した顧客・センサ・ログ種別の .log のうち、最新の更新時刻 (epoch) を返す。
# ファイルが1つもなければ 0 を返す。
latest_mtime() {
    local customer="$1" sensor="$2" kind="$3"
    local files=("$CUSTOMERLOG_DIR"/fluentd.writer_"${customer}"_0001.file."${sensor}"."${kind}".*.log)
    local newest=0 m
    if [ ${#files[@]} -gt 0 ]; then
        while read -r m; do
            [ "$m" -gt "$newest" ] && newest="$m"
        done < <(stat -c %Y -- "${files[@]}" 2>/dev/null)
    fi
    echo "$newest"
}

# 顧客の .buff.meta の中身にセンサ識別子があれば 0 を返す。
# ファイル名は1秒以下で変わるので、ワイルドカードで直接読み、
# 読む前に消えたファイルのエラーは無視する。
sensor_in_buffer() {
    local customer="$1" sensor="$2"
    local files=("$BUFFER_DIR"/fluentd.writer_"${customer}"_0001.kafka2.dummy.*.buff.meta)
    [ ${#files[@]} -gt 0 ] || return 1
    grep -aqF -- "$sensor" "${files[@]}" 2>/dev/null
}

# ---------- 一覧ファイルの読み込み ----------
CUSTOMERS=()
SENSORS=()
INVALID_LINES=()
lineno=0
while IFS= read -r line || [ -n "$line" ]; do
    lineno=$((lineno + 1))
    line="${line%$'\r'}"
    read -r customer sensor extra <<<"$line"
    [ -z "${customer:-}" ] && continue
    [[ "$customer" == \#* ]] && continue
    if [[ "$customer" =~ ^[A-Z]{4,5}$ && "${sensor:-}" =~ ^[a-z][a-z0-9]{3}[0-9]{4}$ && -z "${extra:-}" ]]; then
        CUSTOMERS+=("$customer")
        SENSORS+=("$sensor")
    else
        INVALID_LINES+=("${lineno}行目: $line")
    fi
done <"$LIST_FILE"

TOTAL=${#SENSORS[@]}
if [ "$TOTAL" -eq 0 ]; then
    echo "エラー: 一覧ファイルに有効な行がありません: $LIST_FILE" >&2
    exit 2
fi

# ---------- 1. /var/customerlog の確認 ----------
THREAT_MTIME=()
TRAFFIC_MTIME=()
THREAT_OK=()           # 1=customerlog で確認 / 2=buffer で確認 / 0=未確認
PENDING=()             # buffer 確認が必要なセンサの添字

for i in "${!SENSORS[@]}"; do
    THREAT_MTIME[i]=$(latest_mtime "${CUSTOMERS[i]}" "${SENSORS[i]}" threat)
    TRAFFIC_MTIME[i]=$(latest_mtime "${CUSTOMERS[i]}" "${SENSORS[i]}" traffic)
    if [ "${THREAT_MTIME[i]}" -ge "$THRESHOLD" ]; then
        THREAT_OK[i]=1
    else
        THREAT_OK[i]=0
        PENDING+=("$i")
    fi
done

# ---------- 2. /opt/fluent/buffer の確認 (threat 未更新のセンサのみ) ----------
attempt=1
while [ ${#PENDING[@]} -gt 0 ] && [ "$attempt" -le "$BUFFER_ATTEMPTS" ]; do
    [ "$attempt" -gt 1 ] && sleep "$BUFFER_INTERVAL"
    still=()
    for i in "${PENDING[@]}"; do
        if sensor_in_buffer "${CUSTOMERS[i]}" "${SENSORS[i]}"; then
            THREAT_OK[i]=2
        else
            still+=("$i")
        fi
    done
    PENDING=("${still[@]+"${still[@]}"}")
    attempt=$((attempt + 1))
done

# ---------- 3. 結果の出力 ----------
OUTPUT_FILE="$OUTPUT_DIR/logcheck_$(date +%Y%m%d_%H%M%S).txt"
NG_SENSOR=0            # threat も buffer も確認できなかったセンサ数
NG_TRAFFIC=0           # traffic が未更新のセンサ数
BUFFER_OK=0            # buffer で正常と判断したセンサ数

last_update() {
    if [ "$1" -eq 0 ]; then echo "ファイルなし"; else echo "最終更新 $(fmt_time "$1")"; fi
}

{
    echo "ログ受信確認結果"
    echo "実行日時  : $(date '+%F %T')"
    echo "時刻指定  : $(fmt_time "$THRESHOLD") 以降"
    echo "一覧      : $LIST_FILE (${TOTAL}センサ)"
    echo "----------------------------------------"

    for i in "${!SENSORS[@]}"; do
        id="${CUSTOMERS[i]} ${SENSORS[i]}"
        if [ "${THREAT_OK[i]}" -eq 0 ]; then
            NG_SENSOR=$((NG_SENSOR + 1))
            echo "[未受信] $id threat: 更新なし ($(last_update "${THREAT_MTIME[i]}"))、buffer でもセンサ識別子を確認できず (${BUFFER_ATTEMPTS}回試行)"
        elif [ "${THREAT_OK[i]}" -eq 2 ]; then
            BUFFER_OK=$((BUFFER_OK + 1))
        fi
        if [ "${TRAFFIC_MTIME[i]}" -lt "$THRESHOLD" ]; then
            NG_TRAFFIC=$((NG_TRAFFIC + 1))
            echo "[traffic] $id traffic: 更新なし ($(last_update "${TRAFFIC_MTIME[i]}"))"
        fi
    done

    if [ "$NG_SENSOR" -eq 0 ] && [ "$NG_TRAFFIC" -eq 0 ]; then
        echo "記載対象なし (全センサで時刻指定以降の受信を確認)"
    fi

    if [ ${#INVALID_LINES[@]} -gt 0 ]; then
        echo "----------------------------------------"
        echo "一覧ファイルの形式が不正で確認していない行:"
        printf '  %s\n' "${INVALID_LINES[@]}"
    fi

    echo "----------------------------------------"
    echo "サマリ"
    echo "  確認センサ数                      : $TOTAL"
    echo "  未受信 (threat・buffer とも不可)  : $NG_SENSOR"
    echo "  traffic 更新なし                  : $NG_TRAFFIC"
    echo "  buffer で正常と判断               : $BUFFER_OK"
    echo "  一覧の不正行                      : ${#INVALID_LINES[@]}"
} > >(tee "$OUTPUT_FILE")
wait

echo "結果ファイル: $OUTPUT_FILE"

if [ "$NG_SENSOR" -gt 0 ] || [ "$NG_TRAFFIC" -gt 0 ]; then
    exit 1
fi
exit 0
